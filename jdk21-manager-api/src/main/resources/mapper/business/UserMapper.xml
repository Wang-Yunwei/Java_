<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mdtg.business.user.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="mdtg.business.common.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="gender" column="gender"/>
        <result property="identityCard" column="identity_card"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="roleIds" column="role_ids" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="sysUserId" column="sys_user_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createName" column="create_name"/>
        <result property="createDate" column="create_date"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateName" column="update_name"/>
        <result property="updateDate" column="update_date"/>
        <result property="companyCode" column="company_code"/>
        <result property="companyName" column="company_name"/>
        <result property="secondOrgCode" column="second_org_code"/>
        <result property="secondOrgName" column="second_org_name"/>
        <result property="orgCode" column="org_code"/>
        <result property="orgName" column="org_name"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>

    <!-- 1. 主查询：获取数据列表 -->
    <select id="queryUser" resultType="mdtg.business.user.dto.QueryUserOutputDTO">
        SELECT id, username, phone, role_ids, status, create_date, org_code, org_name FROM mdtg_user
        <!-- 使用 customSqlSegment 自动拼接 WHERE 条件 -->
        ${ew.customSqlSegment}
    </select>

    <!-- 2. 统计查询：获取总数 (关键修复) -->
    <!-- ID 必须是 queryUser_count -->
    <select id="queryUser_count" resultType="java.lang.Long">
        SELECT COUNT(*) FROM mdtg_user
        <!-- 复用同样的 WHERE 条件 -->
        ${ew.customSqlSegment}
    </select>
</mapper>
